# Copy this file to .env and fill in real values. Never commit .env.

# Any random long string, used to sign JWTs
JWT_SECRET=

# Gmail account used to send transactional emails (order confirmations, etc.)
# EMAIL_PASSWORD must be a Gmail "App Password", not your normal login password:
# https://myaccount.google.com/apppasswords (requires 2FA enabled on the account)
EMAIL_USER=
EMAIL_PASSWORD=

# Shared fallback "password" accepted for admin accounts flagged as logged in via Google
# (see AdminService.signIn) - any long random string works
GOOGLE_PASS=

# PostgreSQL connection - these same values are used by docker-compose.yml to
# configure the Postgres container (see README), so keep them in sync if you change them
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=Tahams

# Initial admin account, created by `npm run seed:admin` (only needed once per environment -
# POST /api/admin/create requires an existing admin's JWT, so this is how you bootstrap the first one)
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session config
SESSION_MAX_AGE=300000
SESSION_SECRET=

# Cloudinary (image uploads) - create a free account at https://cloudinary.com
# Cloud name, API key and secret are on your Cloudinary dashboard home page
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pathao courier API - request sandbox/test credentials from Pathao Merchant support
# https://merchant.pathao.com (sandbox base URL differs from production)
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_BASE_URL=https://api-hermes.pathao.com
# Pathao Webhook Integration panel (Callback URL: <your-api-domain>/admin/pathao-webhook)
# Two DIFFERENT secrets are involved — don't merge them:
#   HANDSHAKE_SECRET = fixed value Pathao SHOWS you in the panel (e.g.
#     "f3992ecc-59da-4cbe-a049-a13da2018d51") — echoed back on the one-time
#     webhook_integration verification call. Copy it exactly as shown.
#   PATHAO_WEBHOOK_SECRET = a secret YOU make up and type into the panel's
#     "Secret" field — used to verify X-PATHAO-Signature on real events.
PATHAO_WEBHOOK_HANDSHAKE_SECRET=
PATHAO_WEBHOOK_SECRET=

# FraudSpy API (fraud/order checker) - request an API key from https://fraudspy.com.bd
FRAUDSPY_API_KEY=
FRAUDURL=https://fraudspy.com.bd/api/v1/search
